<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17"><diagram id="mxc-claude-code" name="MXC sandbox architecture"><mxGraphModel dx="1500" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b style="font-size:20px"&gt;Claude Code in a Microsoft Execution Containers (MXC) sandbox&lt;/b&gt;&lt;br&gt;&lt;span style="color:#475569"&gt;Solution architecture · native Windows developer workstation · ProcessContainer backend with loopback egress proxy&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#0F172A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1100" height="50" as="geometry"/></mxCell><mxCell id="host" value='&lt;b style="font-size:13px;color:#5B6B7F"&gt;Developer workstation · Windows 11 24H2+&lt;/b&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#5B6B7F;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1070" height="870" as="geometry"/></mxCell><mxCell id="net" value='&lt;b style="font-size:13px;color:#6B7F5B"&gt;Internet / corporate network&lt;/b&gt;&lt;br&gt;&lt;span style="color:#475569"&gt;reachable only if listed in allowlist.txt&lt;/span&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6F8F3;strokeColor=#6B7F5B;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="370" height="870" as="geometry"/></mxCell><mxCell id="dev" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Developer&lt;/b&gt;&lt;br&gt;PowerShell / Windows Terminal' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="190" height="74" as="geometry"/></mxCell><mxCell id="launch" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Start-ClaudeSandbox.ps1&lt;/b&gt;&lt;br&gt;builds policy.json · env block&lt;br&gt;starts proxy · runs wxc-exec' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="275" y="110" width="230" height="74" as="geometry"/></mxCell><mxCell id="wxc" value='&lt;b style="font-size:13px;color:#0F172A"&gt;wxc-exec.exe&lt;/b&gt;&lt;br&gt;MXC runner (@microsoft/mxc-sdk)&lt;br&gt;--probe · Learn · Audit' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="545" y="110" width="200" height="74" as="geometry"/></mxCell><mxCell id="proxy" value='&lt;b style="font-size:13px;color:#0F172A"&gt;egress-proxy.mjs&lt;/b&gt;&lt;br&gt;127.0.0.1:18080 (host side)&lt;br&gt;hostname allowlist · no TLS MITM&lt;br&gt;every decision → egress.jsonl' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.8;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="265" height="90" as="geometry"/></mxCell><mxCell id="band" value='&lt;b style="font-size:13px;color:#0F172A"&gt;MXC enforcement layer  (Windows kernel / PSEC)&lt;/b&gt;&lt;br&gt;AppContainer file ACLs · WFP filter: egress → proxy only&lt;br&gt;job object: all child processes inherit · UI, clipboard, input off' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#3730A3;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="45" y="234" width="1020" height="62" as="geometry"/></mxCell><mxCell id="box" value='&lt;b style="font-size:13px;color:#4F46E5"&gt;MXC ProcessContainer (AppContainer, destroyOnExit)&lt;/b&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFBFF;strokeColor=#4F46E5;strokeWidth=2.0;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;dashed=1;dashPattern=7 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="45" y="320" width="630" height="330" as="geometry"/></mxCell><mxCell id="agent" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Claude Code (claude.exe)&lt;/b&gt;&lt;br&gt;interactive TUI via shared console&lt;br&gt;CLAUDE_CONFIG_DIR → sandbox state' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=2.4;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="365" width="280" height="74" as="geometry"/></mxCell><mxCell id="env" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Clean environment block&lt;/b&gt;&lt;br&gt;no host env vars or tokens&lt;br&gt;HTTP(S)_PROXY injected by MXC&lt;br&gt;no git credential helper' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.0;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="385" y="365" width="260" height="74" as="geometry"/></mxCell><mxCell id="git" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Git Bash + git&lt;/b&gt;&lt;br&gt;commits locally, no push creds' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="475" width="180" height="66" as="geometry"/></mxCell><mxCell id="mcp" value='&lt;b style="font-size:13px;color:#0F172A"&gt;node / npx&lt;/b&gt;&lt;br&gt;stdio MCP servers' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="475" width="185" height="66" as="geometry"/></mxCell><mxCell id="plug" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Plugins · skills · hooks&lt;/b&gt;&lt;br&gt;installed in sandbox config' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="475" width="175" height="66" as="geometry"/></mxCell><mxCell id="tools" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Build &amp;amp; test tools&lt;/b&gt;&lt;br&gt;dotnet, python, npm scripts …  (toolchains added read-only via -ExtraReadOnly)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.2;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="75" y="562" width="570" height="58" as="geometry"/></mxCell><mxCell id="ws" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Project workspace — read/write&lt;/b&gt;&lt;br&gt;C:\src\&amp;lt;repo&amp;gt;  (incl. .git;  .env denied)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="330" width="355" height="62" as="geometry"/></mxCell><mxCell id="state" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Sandbox state — read/write, private&lt;/b&gt;&lt;br&gt;%LOCALAPPDATA%\agent-sandboxes\&amp;lt;name&amp;gt;&lt;br&gt;home · .claude (plugins, MCP, login) · tmp&lt;br&gt;npm-cache · gitconfig · policy.json · logs' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="405" width="355" height="92" as="geometry"/></mxCell><mxCell id="ro" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Host toolchain — read-only&lt;/b&gt;&lt;br&gt;claude.exe · Git for Windows · Node.js · extras' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="510" width="355" height="62" as="geometry"/></mxCell><mxCell id="deny" value='&lt;b style="font-size:13px;color:#0F172A"&gt;User profile — no access&lt;/b&gt;&lt;br&gt;.ssh  .azure  .aws  .kube  ·  host ~\.claude&lt;br&gt;Credential Manager · browser profiles' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="585" width="355" height="72" as="geometry"/></mxCell><mxCell id="tune" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Policy tuning loop&lt;/b&gt;&lt;br&gt;-Mode Learn  →  enforce + record blocked access (denials.json)&lt;br&gt;-Mode Audit  →  allow + record + Adjusted_*.json (trusted runs only)&lt;br&gt;egress.jsonl denies  →  edit allowlist.txt (hot reload)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.0;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="45" y="690" width="560" height="96" as="geometry"/></mxCell><mxCell id="human" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Human in the loop&lt;/b&gt;&lt;br&gt;reviews diff &amp;amp; local commits on the host&lt;br&gt;⑦ git push with the developer&amp;#x27;s own credentials&lt;br&gt;(the sandbox has none)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="635" y="690" width="430" height="96" as="geometry"/></mxCell><mxCell id="steps" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Flow&lt;/b&gt;&lt;br&gt;①  Developer starts the launcher for a workspace          ②  Launcher starts the allowlisting egress proxy on loopback&lt;br&gt;③  Launcher writes policy.json, checks it with wxc-exec --probe, runs wxc-exec          ④  MXC creates the ProcessContainer&lt;br&gt;⑤  Claude Code and every child process get only the granted paths: workspace + private state (RW), toolchain (RO)&lt;br&gt;⑥  No direct sockets: all HTTP(S) goes through the proxy, which only forwards to allowlisted hostnames          ⑦  Humans push' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.0;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="45" y="808" width="1020" height="118" as="geometry"/></mxCell><mxCell id="api" value='&lt;b style="font-size:13px;color:#0F172A"&gt;api.anthropic.com&lt;/b&gt;&lt;br&gt;Claude API (model calls)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.3;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="125" width="325" height="56" as="geometry"/></mxCell><mxCell id="login" value='&lt;b style="font-size:13px;color:#0F172A"&gt;claude.ai · platform.claude.com&lt;/b&gt;&lt;br&gt;OAuth /login (omit when using an API key)' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.3;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="195" width="325" height="56" as="geometry"/></mxCell><mxCell id="gh" value='&lt;b style="font-size:13px;color:#0F172A"&gt;GitHub&lt;/b&gt;&lt;br&gt;github.com · api.github.com · codeload&lt;br&gt;raw/objects.githubusercontent.com&lt;br&gt;git fetch · plugin marketplaces' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.3;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="265" width="325" height="80" as="geometry"/></mxCell><mxCell id="npm" value='&lt;b style="font-size:13px;color:#0F172A"&gt;registry.npmjs.org&lt;/b&gt;&lt;br&gt;npx MCP servers · npm install' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.3;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="360" width="325" height="56" as="geometry"/></mxCell><mxCell id="int" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Internal Git / Artifactory mirror&lt;/b&gt;&lt;br&gt;recommended: allowlist only these' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.3;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;dashed=1;dashPattern=7 4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="430" width="325" height="62" as="geometry"/></mxCell><mxCell id="blk" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Everything else (incl. raw IPs)&lt;/b&gt;&lt;br&gt;403 from proxy · logged as deny' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.3;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;dashed=1;dashPattern=7 4;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="510" width="325" height="62" as="geometry"/></mxCell><mxCell id="nr" value='&lt;b style="font-size:13px;color:#0F172A"&gt;Not reachable from the sandbox&lt;/b&gt;&lt;br&gt;Docker Desktop · localhost databases&lt;br&gt;IDE extension (localhost WebSocket)&lt;br&gt;→ use MXC wslc backend if needed' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.0;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1135" y="600" width="325" height="80" as="geometry"/></mxCell><mxCell id="legend" value='&lt;b style="font-size:13px;color:#94A3B8"&gt;Legend&lt;/b&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.0;fontFamily=Segoe UI;fontSize=11;fontColor=#334155;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1135" y="700" width="325" height="160" as="geometry"/></mxCell><mxCell id="c101" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="147" as="sourcePoint"/><mxPoint x="275" y="147" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c102" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="110" as="sourcePoint"/><mxPoint x="932" y="110" as="targetPoint"/><Array as="points"><mxPoint x="390" y="88"/><mxPoint x="932" y="88"/></Array></mxGeometry></mxCell><mxCell id="c103" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="147" as="sourcePoint"/><mxPoint x="545" y="147" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c104" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="184" as="sourcePoint"/><mxPoint x="600" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c105" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#EA580C;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="320" as="sourcePoint"/><mxPoint x="932" y="200" as="targetPoint"/><Array as="points"><mxPoint x="650" y="308"/><mxPoint x="932" y="308"/></Array></mxGeometry></mxCell><mxCell id="c106" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#DC2626;strokeWidth=1.6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="320" as="sourcePoint"/><mxPoint x="120" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c107" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="439" as="sourcePoint"/><mxPoint x="165" y="475" as="targetPoint"/><Array as="points"><mxPoint x="215" y="457"/><mxPoint x="165" y="457"/></Array></mxGeometry></mxCell><mxCell id="c108" value="" style="html=1;edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="457" as="sourcePoint"/><mxPoint x="362" y="475" as="targetPoint"/><Array as="points"><mxPoint x="362" y="457"/></Array></mxGeometry></mxCell><mxCell id="c109" value="" style="html=1;edgeStyle=none;rounded=0;en